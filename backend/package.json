{
  "name": "mizara-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "migration:generate": "sequelize-cli --config sequelize.config.js migration:generate --name",
    "migration:all": "sequelize-cli --config sequelize.config.js db:migrate",
    "migration:undo": "sequelize-cli --config sequelize.config.js db:migrate:undo",
    "seeder:generate": "sequelize-cli --config sequelize.config.js seed:generate --name",
    "seeder:all": "sequelize-cli --config sequelize.config.js db:seed:all",
    "seeder:undo": "sequelize-cli --config sequelize.config.js db:seed:undo",
    "logos:build": "node scripts/logos/build-logos.js"
  },
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "@bull-board/nestjs": "^9.11.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.9",
    "expo-server-sdk": "^8.0.0",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^11.3.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
