# Environment
NODE_ENV=development

# docker-compose: host port the backend is published on (container always uses 3000)
BACKEND_PORT=3000
EXTERNAL_PORT=55977 # Port exposed by docker compose

# Database
# POSTGRES_* create the database in docker-compose (first start only) and build
# the api's DATABASE_URL there. Use a strong password on a server; if it has
# URL-special characters (@ : / ? #), percent-encode them in DATABASE_URL.
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=55912 # Port exposed by docker compose (container always uses 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mizara_db
# Used when running outside Docker (pnpm start:dev); keep in sync with the above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mizara_db
# Apply pending migrations on startup (default true). Set false locally to run
# them manually with `pnpm migration:all`; Docker always forces true.
RUN_MIGRATIONS=true

# Authentication
JWT_SECRET=dev-only-change-this-to-a-long-random-secret-key
JWT_ACCESS_EXPIRES_IN=15
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth
# Comma-separated Google OAuth client IDs for Android, iOS, and Web
GOOGLE_OAUTH_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# Email SMTP (Gmail example)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-16-character-gmail-app-password
EMAIL_SMTP_FROM=Mizara <your-email@gmail.com>

# Redis (BullMQ background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue Dashboard Authentication
QUEUE_DASHBOARD_USERNAME=admin
QUEUE_DASHBOARD_PASSWORD=your-strong-random-password

# Expo Push
# Only required once "Enhanced push security" is enabled for the Expo project
EXPO_ACCESS_TOKEN=

# Docker Image Tag
VERSION=latest